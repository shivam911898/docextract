# Copy to .env (never commit .env). Everything here is optional: with no key the app runs in heuristic demo mode.

# AI provider: groq | gemini | none. Default: groq if GROQ_API_KEY is set, else gemini if GEMINI_API_KEY is set, else none.
# LLM_PROVIDER=

# Groq (free key at https://console.groq.com/keys). TEXT ONLY: reads text. Scans and photos are OCR'd first (see OCR_BACKEND).
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b   # faster / cheaper: openai/gpt-oss-20b. Confirm live ids: GET https://api.groq.com/openai/v1/models
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b   # used automatically when the primary model's daily cap is hit (empty = off)
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint (also used by the offline tests)

# Lightweight OCR for scans and photos: auto (default) | rapidocr | tesseract | none. Needs `pip install -r requirements-ocr.txt`
# plus `pip install --no-deps rapidocr-onnxruntime==1.4.4` (RapidOCR), or pytesseract + the tesseract binary.
# OCR_BACKEND=auto
# OCR_THREADS=1            # onnxruntime threads (the Docker image sets 1)
# OCR_MAX_PIXELS=1000000   # larger pages are shrunk to this many pixels before OCR (memory grows with pixels)

# Gemini (optional; reads scans and photos from the image itself). Key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite   # do NOT use Gemini 2.x Flash models: they 404 on the free tier

# Optional table backend for no-key mode: pypdf (default) or docling (needs requirements-docling.txt, heavy).
# An installed Docling is also used instead of the lightweight OCR to read scans and photos.
# EXTRACT_BACKEND=pypdf

# Batch guards (useful on a public demo so one visitor cannot burn your API quota)
# MAX_FILES=10        # files per batch in the web UI (the CLI is uncapped)
# MAX_PAGES=3         # pages per document read
# MAX_FILE_MB=15      # per-file size cap

# Optional Google Sheets append (service account must have edit access to the sheet).
# Leave unset on a public demo: the "Push to Google Sheet" button only appears when both are set.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
